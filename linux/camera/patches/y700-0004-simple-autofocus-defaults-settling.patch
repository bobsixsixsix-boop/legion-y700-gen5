@@ -314,8 +315,21 @@ void IPASoftSimple::processStats(const uint32_t frame,
 	for (auto const &algo : algorithms())
 		algo->process(context_, frame, frameContext, stats_, metadata);
 	if (stats_->valid && stats_->focusSamples) {
-		const uint64_t focus = stats_->focusSum * 1024 /
-				       stats_->focusSamples;
+		/*
+		 * The gradient sum scales with the image brightness: divide
+		 * by the mean luminance so that an exposure change alone
+		 * does not look like a focus change and restart a scan.
+		 */
+		uint64_t histSum = 0, histWeighted = 0;
+		for (unsigned int i = 0; i < SwIspStats::kYHistogramSize; i++) {
+			histSum += stats_->yHistogram[i];
+			histWeighted += static_cast<uint64_t>(stats_->yHistogram[i]) * (2 * i + 1);
+		}
+		/* the mean bin in half-bin units (1 .. 127); 64 = mid grey */
+		const uint64_t meanHalfBins =
+			histSum ? std::max<uint64_t>(1, histWeighted / histSum) : 64;
+		const uint64_t focus = stats_->focusSum * 1024 * 64 /
+				       (static_cast<uint64_t>(stats_->focusSamples) * meanHalfBins);
 		metadata.set(controls::FocusFoM,
 			     static_cast<int32_t>(std::min<uint64_t>(
 				     focus, std::numeric_limits<int32_t>::max())));
