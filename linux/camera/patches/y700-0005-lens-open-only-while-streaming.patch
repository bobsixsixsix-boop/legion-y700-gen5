+/**
+ * \brief Open the lens subdev to control the lens
+ *
+ * Open the lens subdev node, if it isn't open already. Most lens drivers keep
+ * the actuator powered, and holding its position, for as long as the node is
+ * open. Pipeline handlers that control when the lens is powered call open()
+ * when starting capture and close() when stopping it. Pipeline handlers that
+ * don't call open() get the lens opened on demand by the first call to
+ * setFocusPosition(), and kept open until close() is called or the CameraLens
+ * is destroyed.
+ *
+ * \return 0 on success or a negative error code otherwise
+ */
+int CameraLens::open()
+{
+	if (active_)
+		return 0;
+
+	/*
+	 * Use a new instance for every open, so that a failed open never
+	 * leaves a half-initialised device behind, and the control information
+	 * of a previous open is never rebuilt in place.
+	 */
+	auto subdev = std::make_unique<V4L2Subdevice>(entity_);
+	int ret = subdev->open();
+	if (ret < 0)
+		return ret;
+
+	active_ = std::move(subdev);
 	return 0;
 }
 
+/**
+ * \brief Close the lens subdev
+ *
+ * Close the lens subdev node, if it is open, allowing the lens driver to power
+ * the actuator down. The lens driver decides where the lens rests when
+ * powered down; drivers that would let the lens hit its end stop are expected
+ * to move it to a safe position themselves, as the dw9719 driver does in its
+ * runtime suspend handler.
+ *
+ * Whether the next open() moves the lens back to the position set last
+ * depends on the driver. Callers that need an exact position shall set it
+ * again once the lens is open, keeping in mind that V4L2 skips writing a
+ * control whose value doesn't change.
+ */
+void CameraLens::close()
+{
+	active_.reset();
+}
+
+/**
+ * \fn CameraLens::isOpen()
+ * \brief Check if the lens subdev is open
+ * \return True if the lens subdev is open, false otherwise
+ */
+
 /**
  * \brief This function sets the focal point of the lens to a specific position.
  * \param[in] position The focal point of the lens
  *
  * This function sets the value of focal point of the lens as in \a position.
+ * The lens subdev is opened first if it isn't open, see open().
  *
- * \return 0 on success or -EINVAL otherwise
+ * \return 0 on success or a negative error code otherwise
  */
 int CameraLens::setFocusPosition(int32_t position)
 {
-	ControlList lensCtrls(subdev_->controls());
+	int ret = open();
+	if (ret < 0)
+		return ret;
+
+	ControlList lensCtrls(active_->controls());
 	lensCtrls.set(V4L2_CID_FOCUS_ABSOLUTE, static_cast<int32_t>(position));
 
-	if (subdev_->setControls(&lensCtrls))
+	if (active_->setControls(&lensCtrls))
 		return -EINVAL;
 
 	return 0;
