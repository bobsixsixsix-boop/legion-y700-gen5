+// is the errno of the call that failed). Report and remember it once, so that the libdecor
+// ready loops stop waiting; ask every window to close on every call, which also reaches a
+// window created after the disconnect (handleEvents comes back here each time it is called)
+//
+static void handleDisconnect(int error)
+{
+    if (!_glfw.wl.disconnected)
+    {
+        _glfw.wl.disconnected = GLFW_TRUE;
+        _glfwInputError(GLFW_PLATFORM_ERROR,
+                        "Wayland: Lost the connection to the compositor: %s",
+                        strerror(error));
+    }
+
+    _GLFWwindow* window = _glfw.windowListHead;
+    while (window)
+    {
+        _glfwInputWindowCloseRequest(window);
+        window = window->next;
+    }
