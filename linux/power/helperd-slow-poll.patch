@@ -758,7 +758,11 @@ async fn run(no_polkit: bool, session: bool) -> zbus::Result<()> {
 
     // Poller: LED ring and GPU follow, re-assert USB wake, and PropertiesChanged
     // for objects whose values changed underneath (charger plugged, kernel knob
-    // written by someone else, ...). 5 s is enough for all of these.
+    // written by someone else, ...). 5 s is enough for all of these. With the
+    // screen off on battery a round (the battery and every object over glink)
+    // comes every [poller] poll_s_display_off instead; the 5 s look in between
+    // at the screen and the charger ends that wait at once.
+    const POLL: Duration = Duration::from_secs(5);
     let mut last: HashMap<&'static str, String> = HashMap::new();
     loop {
         shared.profile_tick(&conn, false).await;
@@ -801,7 +805,18 @@ async fn run(no_polkit: bool, session: bool) -> zbus::Result<()> {
             kern.auto_tick();
             watch::<kernel::Kernel>(&conn, kernel::P_KERNEL, &mut last).await;
         }
-        async_io::Timer::after(Duration::from_secs(5)).await;
+        // a charging restart steps every few seconds, and performance has its heat guard
+        let quiet = perf::screen_off() && !f::external_power() && shared.rt.lock().unwrap().arm.is_none()
+            && shared.thermal_target() != "performance";
+        shared.led.set_quiet(quiet);
+        let round = shared.cfg().poller.round(quiet, POLL);
+        let start = std::time::Instant::now();
+        loop {
+            async_io::Timer::after(POLL.min(round.saturating_sub(start.elapsed()))).await;
+            if start.elapsed() >= round || !perf::screen_off() || f::external_power() {
+                break;
+            }
+        }
     }
