+/// The daemon's poll loop (LED ring charge indicator, profile follow, the
+/// PropertiesChanged watch). Every round is a CPU wakeup plus a battery read
+/// over glink; with the panel off the tablet idles for hours, so poll less.
+#[derive(Debug, Clone, Serialize, Deserialize, PartialEq)]
+#[serde(default)]
+pub struct Poller {
+    /// seconds between polls while the display is on
+    pub poll_s: u64,
+    /// seconds between polls while every connected DSI panel is off (DPMS);
+    /// 0 = same as poll_s
+    pub poll_s_display_off: u64,
+}
+
+impl Default for Poller {
+    fn default() -> Self {
+        Poller { poll_s: 5, poll_s_display_off: 30 }
+    }
+}
+
