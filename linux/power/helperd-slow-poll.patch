+// ---------------------------------------------------------------- display power
+
+/// The built-in panel is off: every connected DSI connector reports DPMS
+/// "Off" (`/sys/class/drm/card*-DSI-*/{status,dpms}`). `None` when no DSI
+/// connector is connected (a fake tree, an external-only setup). Only the
+/// connected connectors count: a disconnected DP or writeback connector
+/// reports "On" forever.
+pub fn display_off() -> Option<bool> {
+    let drm = sys::path("/sys/class/drm");
+    let mut connected = false;
+    for name in sys::list_dir(&drm) {
+        if !name.contains("-DSI-") {
+            continue;
+        }
+        let d = drm.join(&name);
+        if sys::read_opt(&d.join("status")).as_deref() != Some("connected") {
+            continue;
+        }
+        connected = true;
+        if sys::read_opt(&d.join("dpms")).as_deref() != Some("Off") {
+            return Some(false);
+        }
+    }
+    connected.then_some(true)
+}
