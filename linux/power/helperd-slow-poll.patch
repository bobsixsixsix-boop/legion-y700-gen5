 }
 
+/// The daemon's poll rounds (charge, LED ring charge color, PropertiesChanged):
+/// every round reads the battery over glink and wakes a CPU. With the screen
+/// off on battery nobody looks and nothing charges, so the rounds spread out.
+#[derive(Debug, Clone, Serialize, Deserialize, PartialEq)]
+#[serde(default)]
+pub struct Poller {
+    /// seconds between rounds while the screen is off on battery; 0 (or not
+    /// longer than the usual round) keeps the usual round
+    pub poll_s_display_off: u64,
+}
+
+impl Default for Poller {
+    fn default() -> Self {
+        Poller { poll_s_display_off: 30 }
+    }
+}
+
+impl Poller {
+    /// The time to the next round: `poll_s_display_off` when `quiet`, else `usual`.
+    pub fn round(&self, quiet: bool, usual: std::time::Duration) -> std::time::Duration {
+        let off = std::time::Duration::from_secs(self.poll_s_display_off);
+        if quiet && off > usual { off } else { usual }
+    }
+}
+
 #[derive(Debug, Clone, Serialize, Deserialize, PartialEq, Default)]
 #[serde(default)]
 pub struct Usb {
@@ -297,6 +323,7 @@ impl Default for Config {
             haptics: Haptics::default(),
             usb: Usb::default(),
             kernel: Kernel::default(),
+            poller: Poller::default(),
         }
     }
 }
@@ -381,6 +408,21 @@ pub fn shell_vars(path: &Path) -> BTreeMap<String, String> {
 #[cfg(test)]
 mod tests {
     use super::*;
+    #[test]
+    fn poller_round() {
+        use std::time::Duration;
+        let five = Duration::from_secs(5);
+        let p = Poller::default();
+        assert_eq!(p.round(false, five), five);
+        assert_eq!(p.round(true, five), Duration::from_secs(30));
+        for s in [0, 3, 5] {
+            assert_eq!(Poller { poll_s_display_off: s }.round(true, five), five, "{s} keeps the usual round");
+        }
+        // a helper.toml without [poller] (the stock daemon's) gets the default
+        let c: Config = toml::from_str("[battery]\ncharge_limit = 90\n").unwrap();
+        assert_eq!((c.battery.charge_limit, c.poller.poll_s_display_off), (90, 30));
+    }
+
     #[test]
     fn roundtrip() {
         let dir = std::env::temp_dir().join(format!("tb323fu-cfg-{}", std::process::id()));
