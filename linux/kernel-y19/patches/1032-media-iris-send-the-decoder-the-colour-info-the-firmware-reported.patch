From 7780b4e3b1e067d3602f3858f996e441fc431e0b Mon Sep 17 00:00:00 2001
From: bobsixsixsix-boop <304558835+bobsixsixsix-boop@users.noreply.github.com>
Date: Wed, 14 Oct 2026 04:30:00 +0000
Subject: [PATCH] media: iris: send the decoder the colour info the firmware
 reported

The firmware raises a source change when a bitstream property differs from what
the driver set. HFI_PROP_SIGNAL_COLOR_INFO is rebuilt from the V4L2 colorimetry on
every bitstream port start, which does not round-trip: a stream without a colour
description reports 0x00021202 and gets 0x14000003 back, a BT.709 stream whose
primaries/transfer are "unspecified" reports 0x35020201 and gets 0x35000001.
So restarting the bitstream port after the first source change raised it again
for every stream, with or without ArmadaOS 1030/1031 (kprobe on
iris_hfi_gen2_packet_session_property vs iris_hfi_gen2_handle_session_property,
SM8850). Keep the value the firmware reported and send it back unchanged.
---
 drivers/media/platform/qcom/iris/iris_hfi_gen2.h         | 4 ++++
 drivers/media/platform/qcom/iris/iris_hfi_gen2_command.c | 9 +++++++++
 .../media/platform/qcom/iris/iris_hfi_gen2_response.c    | 2 ++
 3 files changed, 15 insertions(+)

diff --git a/drivers/media/platform/qcom/iris/iris_hfi_gen2.h b/drivers/media/platform/qcom/iris/iris_hfi_gen2.h
index 21ab58e0a..f30f96dd3 100644
--- a/drivers/media/platform/qcom/iris/iris_hfi_gen2.h
+++ b/drivers/media/platform/qcom/iris/iris_hfi_gen2.h
@@ -23,6 +23,8 @@ struct iris_core;
  * @hfi_frame_info: structure of frame info
  * @src_subcr_params: subscription params to fw on input port
  * @dst_subcr_params: subscription params to fw on output port
+ * @fw_color_info: colour info the firmware last reported for the bitstream
+ * @fw_color_info_valid: @fw_color_info holds a firmware report
  */
 struct iris_inst_hfi_gen2 {
 	struct iris_inst		inst;
@@ -32,6 +34,8 @@ struct iris_inst_hfi_gen2 {
 	struct iris_hfi_frame_info	hfi_frame_info;
 	struct hfi_subscription_params	src_subcr_params;
 	struct hfi_subscription_params	dst_subcr_params;
+	u32				fw_color_info;
+	bool				fw_color_info_valid;
 };
 
 void iris_hfi_gen2_sys_ops_init(struct iris_core *core);
diff --git a/drivers/media/platform/qcom/iris/iris_hfi_gen2_command.c b/drivers/media/platform/qcom/iris/iris_hfi_gen2_command.c
index 8c9bc651a..d50ae3b4d 100644
--- a/drivers/media/platform/qcom/iris/iris_hfi_gen2_command.c
+++ b/drivers/media/platform/qcom/iris/iris_hfi_gen2_command.c
@@ -383,6 +383,15 @@ static int iris_hfi_gen2_set_colorspace(struct iris_inst *inst, u32 plane)
 	color_info = iris_hfi_gen2_get_color_info(matrix_coeff, transfer_char, primaries,
 						  colour_description_present_flag, full_range,
 						  video_format, video_signal_type_present_flag);
+	/*
+	 * Once the firmware has reported the stream's colour info, a decoder sends that
+	 * value back unchanged. Rebuilding it from the V4L2 colorimetry does not round-trip
+	 * (an "unspecified" primaries/transfer becomes reserved, video_format is lost), and
+	 * any difference raises the same source change again every time the bitstream
+	 * port is restarted.
+	 */
+	if (inst->domain == DECODER && inst_hfi_gen2->fw_color_info_valid)
+		color_info = inst_hfi_gen2->fw_color_info;
 
 	inst_hfi_gen2->src_subcr_params.color_info = color_info;
 
diff --git a/drivers/media/platform/qcom/iris/iris_hfi_gen2_response.c b/drivers/media/platform/qcom/iris/iris_hfi_gen2_response.c
index 69f45d0b4..024b2bf12 100644
--- a/drivers/media/platform/qcom/iris/iris_hfi_gen2_response.c
+++ b/drivers/media/platform/qcom/iris/iris_hfi_gen2_response.c
@@ -534,6 +534,8 @@ static void iris_hfi_gen2_read_input_subcr_params(struct iris_inst *inst)
 	struct v4l2_ctrl *ctrl;
 
 	subsc_params = inst_hfi_gen2->src_subcr_params;
+	inst_hfi_gen2->fw_color_info = subsc_params.color_info;
+	inst_hfi_gen2->fw_color_info_valid = true;
 	width = (subsc_params.bitstream_resolution &
 		HFI_BITMASK_BITSTREAM_WIDTH) >> 16;
 	height = subsc_params.bitstream_resolution &
-- 
2.53.0

