From 4bcadb4229a6d5e28115c15396bdd5bbbbb8cd18 Mon Sep 17 00:00:00 2001
From: y700 workspace <304558835+bobsixsixsix-boop@users.noreply.github.com>
Date: Thu, 22 Oct 2026 14:48:05 +0000
Subject: [PATCH] wifi: ath12k: apply BSS_CHANGED_PS from vif_cfg_changed to
 every station link

mac80211 reports BSS_CHANGED_PS through vif_cfg_changed (a vif-level change), but ath12k only
handled it in the per-link bss_info_changed, which never sees it, so station power save was never
switched on in the firmware. Handle it in ath12k_mac_op_vif_cfg_changed() for every link (y8).
Upstream had the same fix (4b66d18918f8) and reverted it (9222582ec524, WCN7850 throughput).
MODULE_VERSION("y700-1041") marks the build (kbuild asserts it).
Generated by linux/kernel-y8/make-1041.py on the tablet tree.

y700 patch file: 1041-ath12k-sta-ps-vif-cfg.patch
---
 drivers/net/wireless/ath/ath12k/mac.c | 29 +++++++++++++++++++++++++++
 1 file changed, 29 insertions(+)

diff --git a/drivers/net/wireless/ath/ath12k/mac.c b/drivers/net/wireless/ath/ath12k/mac.c
index 755bc4a06..4ab08e992 100644
--- a/drivers/net/wireless/ath/ath12k/mac.c
+++ b/drivers/net/wireless/ath/ath12k/mac.c
@@ -4445,6 +4445,30 @@ static int ath12k_mac_fils_discovery(struct ath12k_link_vif *arvif,
 	return ret;
 }
 
+static void ath12k_mac_vif_setup_ps(struct ath12k_link_vif *arvif);
+
+/* BSS_CHANGED_PS arrives here (vif-level cfg), not in bss_info_changed: apply it to every link */
+static void ath12k_mac_vif_cfg_ps(struct ieee80211_hw *hw, struct ieee80211_vif *vif)
+{
+	struct ath12k_vif *ahvif = ath12k_vif_to_ahvif(vif);
+	unsigned long links = ahvif->links_map;
+	struct ath12k_link_vif *arvif;
+	u8 link_id;
+
+	lockdep_assert_wiphy(hw->wiphy);
+
+	if (vif->type != NL80211_IFTYPE_STATION)
+		return;
+
+	ahvif->ps = vif->cfg.ps;
+	for_each_set_bit(link_id, &links, IEEE80211_MLD_MAX_NUM_LINKS) {
+		arvif = wiphy_dereference(hw->wiphy, ahvif->link[link_id]);
+		if (!arvif || !arvif->ar || !arvif->ar->ab->hw_params->supports_sta_ps)
+			continue;
+		ath12k_mac_vif_setup_ps(arvif);
+	}
+}
+
 void ath12k_mac_op_vif_cfg_changed(struct ieee80211_hw *hw,
 				   struct ieee80211_vif *vif,
 				   u64 changed)
@@ -4514,6 +4538,9 @@ void ath12k_mac_op_vif_cfg_changed(struct ieee80211_hw *hw,
 			}
 		}
 	}
+
+	if (changed & BSS_CHANGED_PS)
+		ath12k_mac_vif_cfg_ps(hw, vif);
 }
 EXPORT_SYMBOL(ath12k_mac_op_vif_cfg_changed);
 
@@ -15619,3 +15646,5 @@ int ath12k_mac_vif_set_keepalive(struct ath12k_link_vif *arvif,
 
 	return 0;
 }
+
+MODULE_VERSION("y700-1041");
-- 
