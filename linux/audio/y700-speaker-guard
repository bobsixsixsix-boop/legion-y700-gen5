#!/bin/bash
# y700-speaker-guard: keep the speakers behind their protection.
#
# The upstream platform package opens the amplifiers up (aw_dev_*_volume 21 instead of the safe 159)
# while PipeWire runs, on the assumption that everything reaching the speakers goes through the
# protecting filter chain (effect_input.speakers: high-pass, compressor, RMS limit, limiter). Three
# things break that assumption and nothing upstream catches them:
#   1. a user or an app picks "Speakers (raw, unprotected)" (the ALSA sink) as the default output;
#   2. an app sends its own stream straight to that raw sink (per-app output choice, pactl move-sink-input):
#      the default output stays right, the protection node exists, and the stream still bypasses it;
#   3. the filter-chain node dies while PipeWire keeps running.
# The check (user service, a few pw-*/pactl calls) puts the default output back on the tuned sink,
# moves bypassing streams onto it, and keeps the amplifier gain conditional on the whole picture:
# protection node present, hardware sink present, no bypassing stream. While any of that is false the
# amplifiers sit at the safe attenuation (upstream helper), and they are only raised again once the
# raise command succeeded. It also hands the output to headphones (Bluetooth, USB) when they connect and
# back to the tuned sink when they go (2026-10-19).
# When it runs (2026-10-15 power audit: the old 2 s poll spawned ~28 processes and opened 6 PipeWire
# clients every round, around the clock, with nothing playing): on every sink / sink-input / server
# event from `pactl subscribe` (default output changed, a stream appeared or moved, a sink appeared,
# vanished or changed volume), once the events have been quiet for 0.3 s (at most 2 s of draining, so a
# volume drag still gets a check every 2 s); otherwise every 30 s while everything is in order and
# every 2 s while it is not (protection or hardware sink missing, gain held down), which keeps the
# "~10 s without the hardware sink -> repair" timing below. If the subscriber dies (pipewire-pulse
# restart) it is restarted and the 2 s poll covers the gap. A bypassing stream is now moved ~0.3 s
# after it appears instead of up to 2 s.
PROT=effect_input.speakers          # upstream protection chain (what the amplifier gain is conditional on)
PROT_OUT=effect_output.speakers     # its playback side: the only stream that may feed the hardware sink
TUNED=effect_input.y700_lenovo      # our Lenovo tuning, feeds PROT; the default output users should see
HW=alsa_output.platform-sound.HiFi__Speaker__sink
GAIN=/usr/libexec/tb323fu/tb323fu-speaker-gain
export LC_ALL=C                     # pactl output is parsed below (its headings are translated)
gain=on                             # what we believe the amplifiers are at (upstream unit raised them at start)
nohw=0
kded_fixed=-600                     # SECONDS of the last kded6 restart (volume keys on a fixed stage)
ext_prev=""                         # headphone sinks (Bluetooth, USB) seen at the previous check
set_gain() {                        # only remember a state the helper confirmed; a failed command is retried next round
	[ "$gain" = "$1" ] && return 0
	"$GAIN" "$1" >/dev/null 2>&1 && gain=$1
}
check() {
	nodes=$(pw-cli ls Node 2>/dev/null)
	have_prot=0; have_hw=0
	printf '%s' "$nodes" | grep -q "node.name = \"$PROT\"" && have_prot=1
	printf '%s' "$nodes" | grep -q "node.name = \"$HW\"" && have_hw=1
	cfg=$(pw-metadata 0 default.configured.audio.sink 2>/dev/null | grep -o '"name":"[^"]*"' | cut -d'"' -f4)
	case "$cfg" in
	*HiFi__Speaker__sink | effect_input.speaker_plus*)
		pw-metadata 0 default.configured.audio.sink "{\"name\":\"$TUNED\"}" >/dev/null 2>&1
		notify-send -a "Y700" -i audio-speakers "扬声器输出已切回“联想调音”" "“Speakers (raw, unprotected)”绕过扬声器保护，功放会过载；它只用于调试。" 2>/dev/null
		;;
	"" | effect_input.speakers)
		# after a PipeWire restart WirePlumber lands on the upstream "Speakers" (or nothing): put the
		# tuned sink back once its node exists (it chains into the protection, so nothing is lost)
		printf '%s' "$nodes" | grep -q "node.name = \"$TUNED\"" &&
			pw-metadata 0 default.configured.audio.sink "{\"name\":\"$TUNED\"}" >/dev/null 2>&1
		;;
	esac
	# Headphones (Bluetooth, USB audio) take the output when they connect and give it back when they go, like a
	# phone (2026-10-19: Bluetooth earbuds connected, sound still on the speakers). Nothing else did it: the configured
	# default stays on the tuned sink (above; WirePlumber keeps it while that sink exists), our two speaker stages
	# have priority.session 1400/1500 against a Bluetooth sink's 1010, and pipewire-pulse's module-switch-on-connect
	# is not loaded. Edge-triggered: only a sink that was not there at the previous check (or at guard start) is
	# switched to, so choosing the speakers while the headset stays connected sticks. When the chosen headset goes,
	# the output goes back to another connected one, else the tuned sink - not to whatever WirePlumber's history
	# holds (the upstream "Speakers" stage, or a sink that is not there).
	ext=$(pactl list short sinks 2>/dev/null | awk '$2 ~ /^(bluez_output\.|alsa_output\.usb-)/ {print $2}')
	ext=$(echo $ext)
	new=""
	for s in $ext; do case " $ext_prev " in *" $s "*) ;; *) new=$s ;; esac; done
	if [ -n "$new" ]; then
		pw-metadata 0 default.configured.audio.sink "{\"name\":\"$new\"}" >/dev/null 2>&1
		desc=$(pactl list sinks 2>/dev/null | awk -v n="$new" '/^[ \t]*Name: / {f = ($2 == n)}
			f && /^[ \t]*Description: / {sub(/^[^:]*: /, ""); print; exit}')
		echo "output connected: $new is now the default"
		notify-send -a "Y700" -i audio-headphones "声音已切到“${desc:-$new}”" "断开后自动回到扬声器（联想调音）。" 2>/dev/null
	else
		case "$cfg" in
		bluez_output.* | alsa_output.usb-*)
			case " $ext " in
			*" $cfg "*) ;;
			*)
				back=${ext##* }
				[ -z "$back" ] && printf '%s' "$nodes" | grep -q "node.name = \"$TUNED\"" && back=$TUNED
				if [ -n "$back" ]; then
					pw-metadata 0 default.configured.audio.sink "{\"name\":\"$back\"}" >/dev/null 2>&1
					echo "output gone: $cfg, default back to $back"
				fi ;;
			esac ;;
		esac
	fi
	ext_prev=$ext
	# streams feeding the raw hardware sink directly: everything on it except the protection chain's
	# own output is moved to the tuned sink. The amplifiers only go down for a stream that is STILL on the
	# raw sink after the move (one that refused it, e.g. asked not to be moved): lowering them after a
	# successful move protected nothing - the stream was already safe - and was an unramped 13 dB gain step
	# (POPS.md, a pop candidate). Measured 2026-10-17 (bypass-test.sh): moved 0.26 s after it appeared.
	bypass=""
	if [ $have_hw -eq 1 ]; then
		hw_id=$(pactl list short sinks 2>/dev/null | awk -v n="$HW" '$2 == n {print $1; exit}')
		raw_streams() { pactl list sink-inputs 2>/dev/null | awk -v hw="$hw_id" -v ok="$PROT_OUT" '
			function flush() { if (id != "" && sink == hw && name != ok) print id }
			/^Sink Input #/ { flush(); id = substr($3, 2); sink = ""; name = "" }
			/^[ \t]*Sink: / { sink = $2 }
			/^[ \t]*node\.name = / { name = $3; gsub(/"/, "", name) }
			END { flush() }'; }
		[ -n "$hw_id" ] && bypass=$(raw_streams)
		if [ -n "$bypass" ]; then
			for id in $bypass; do pactl move-sink-input "$id" "$TUNED" >/dev/null 2>&1; done
			bypass=$(raw_streams)            # what is left: only these keep the amplifiers down
			if [ -z "$bypass" ]; then
				notify-send -a "Y700" -i audio-speakers "一个应用的声音绕过了扬声器保护" "已把它移到“联想调音”。" 2>/dev/null
			else
				notify-send -a "Y700" -i audio-speakers "一个应用的声音绕过了扬声器保护" "它不让移动，功放降到安全档，直到它停止。" 2>/dev/null
			fi
		fi
	fi
	# the hardware sink itself gone (card still there)? Seen 2026-10-13 after a PipeWire restart: WirePlumber's
	# UCM disable turned the DSP routes off, the re-open failed with EINVAL, it fell back to the "pro-audio"
	# profile and saved that choice. Put the mixer defaults back and select the HiFi profile again.
	if [ $have_hw -eq 0 ] && [ -e /proc/asound/card0/pcm0p ]; then
		# time-based, not a round count: events can run several checks a second during a PipeWire restart
		[ "$nohw" -eq 0 ] && nohw=$((SECONDS > 0 ? SECONDS : 1))     # 0 means "sink present"
		if [ $((SECONDS - nohw)) -ge 10 ]; then      # 10 s without the sink
			# audio-defaults re-initialises the mixer and leaves the amplifiers at the safe 159: that is a
			# new hardware state, so forget the old gain belief and raise it again only once the sink,
			# the protection node and the routing are back (checked below on the following rounds)
			/usr/libexec/tb323fu/tb323fu-audio-defaults 0 >/dev/null 2>&1
			gain=off
			card=$(pw-cli ls Device 2>/dev/null | awk '/^	id [0-9]+/ {id=$2} /device.name = "alsa_card.platform-sound"/ {print id; exit}' | tr -d ,)
			[ -n "$card" ] && wpctl set-profile "$card" 1 >/dev/null 2>&1
			notify-send -a "Y700" -i audio-speakers "扬声器设备已自动恢复" "DSP 路由被关掉、声卡掉到了 Pro Audio 配置；已恢复默认路由并切回 HiFi。" 2>/dev/null
			nohw=0
		fi
	else
		nohw=0
	fi
	# the two fixed stages behind the tuned sink stay at unity: the user's volume is the tuned sink's
	# (control centre / Plasma applet on the default sink). After the 2026-10-13 PipeWire restarts the
	# protection sink sat at 45 % and the hardware sink at 73 %, i.e. -10 dB on top of the chain's own
	# curve, and "test sound" on the tuned sink was inaudible while raw was loud.
	moved=""
	for fixed in "$PROT" "$HW"; do
		v=$(pactl get-sink-volume "$fixed" 2>/dev/null | head -1 | grep -oE '[0-9]+%' | head -1 | tr -d %)
		if [ -n "$v" ] && [ "$v" -ne 100 ]; then
			pactl set-sink-volume "$fixed" 100% >/dev/null 2>&1
			moved="$moved $fixed=$v%"
		fi
	done
	# A fixed stage moved while the whole chain is up and the tuned sink is the default: some volume control is
	# bound to that stage instead of the user's volume. The one seen three times is the volume keys (kded6's
	# audioshortcutsservice latched onto the boot-time default, 2026-10-17: the keys moved "Speakers" 100->95->100
	# all night, the tuned sink never moved). A fresh kded6 binds to the current default; at most every 10 min
	# (a PipeWire restart also leaves the stages off 100 % - the same restart then just refreshes kded6's view).
	if [ -n "$moved" ] && [ $have_prot -eq 1 ] && [ $have_hw -eq 1 ] && [ $((SECONDS - kded_fixed)) -ge 600 ] &&
	   [ "$(pactl get-default-sink 2>/dev/null)" = "$TUNED" ] && systemctl --user is-active --quiet plasma-kded6.service; then
		kded_fixed=$SECONDS
		echo "fixed stage moved ($moved): restarting plasma-kded6 so the volume keys bind to $TUNED"
		systemctl --user restart plasma-kded6.service
	fi
	# amplifier gain: up only while the protection node and the hardware sink exist and nothing bypasses them
	if [ $have_prot -eq 1 ] && [ $have_hw -eq 1 ] && [ -z "$bypass" ]; then set_gain on; else set_gain off; fi
	# in order = gain confirmed up and nothing was moved: only then may the next check wait for events
	healthy=0
	[ "$gain" = on ] && [ $have_prot -eq 1 ] && [ $have_hw -eq 1 ] && [ -z "$bypass" ] && healthy=1
}

sub_pid=""
start_subscriber() {
	[ -n "$sub_pid" ] && kill "$sub_pid" 2>/dev/null
	exec 3< <(exec pactl subscribe 2>/dev/null)
	sub_pid=$!
}
trap '[ -n "$sub_pid" ] && kill "$sub_pid" 2>/dev/null' EXIT
start_subscriber
healthy=0
while :; do
	check
	wait_s=$([ $healthy -eq 1 ] && echo 30 || echo 2)
	deadline=$((SECONDS + wait_s))
	while :; do
		left=$((deadline - SECONDS)); [ $left -le 0 ] && break
		if IFS= read -r -t "$left" -u 3 line; then
			case "$line" in
			*" on sink #"* | *" on sink-input #"* | *" on server"*)
				# settle: let a burst (stream start, volume drag, PipeWire restart) finish - 0.3 s without
				# another sink / stream / server event - but at most 2 s. Only those events count as activity:
				# the client connect/disconnect lines (every pactl call, ours included) used to count too and
				# kept the drain going for the whole 2 s, so a bypassing stream played unprotected for 1.8 s
				# instead of ~0.3 s (linux/audio/bypass-test.sh, 2026-10-17). Microseconds from EPOCHREALTIME.
				t_end=$(( ${EPOCHREALTIME/./} + 2000000 )); t_quiet=$(( ${EPOCHREALTIME/./} + 300000 ))
				while :; do
					now=${EPOCHREALTIME/./}
					(( now >= t_quiet || now >= t_end )) && break
					w=$(( (t_quiet < t_end ? t_quiet : t_end) - now ))
					printf -v w '%d.%06d' $((w / 1000000)) $((w % 1000000))     # builtin: no fork
					IFS= read -r -t "$w" -u 3 line || break
					case "$line" in
					*" on sink #"* | *" on sink-input #"* | *" on server"*) t_quiet=$(( ${EPOCHREALTIME/./} + 300000 )) ;;
					esac
				done
				break ;;
			esac
		else
			rc=$?
			if [ $rc -le 128 ]; then
				# EOF: the subscriber is gone (pipewire-pulse restarted or not up yet): poll until it is back
				sleep 2; start_subscriber; break
			fi
			break           # timeout: the periodic check
		fi
	done
done
