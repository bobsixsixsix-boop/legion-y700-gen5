[Unit]
Description=y700: Lenovo speaker tuning filter (feeds the protected Speakers sink)
After=pipewire.service wireplumber.service tb323fu-speaker-gain.service
BindsTo=pipewire.service

[Service]
ExecStart=/usr/bin/pipewire -c /usr/local/share/y700/y700-lenovo-tuning.conf
Restart=on-failure
RestartSec=3

[Install]
WantedBy=pipewire.service
