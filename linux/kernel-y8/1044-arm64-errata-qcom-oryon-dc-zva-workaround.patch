diff --git a/arch/arm64/kernel/traps.c b/arch/arm64/kernel/traps.c
index 9142820..56d5796 100644
--- a/arch/arm64/kernel/traps.c
+++ b/arch/arm64/kernel/traps.c
@@ -29,6 +29,7 @@
 #include <linux/kasan.h>
 #include <linux/ubsan.h>
 #include <linux/cfi.h>
+#include <linux/debugfs.h>
 
 #include <asm/atomic.h>
 #include <asm/bug.h>
@@ -558,6 +559,36 @@ void do_el1_mops(struct pt_regs *regs, unsigned long esr)
 		uaccess_ttbr0_disable();			\
 	}
 
+/*
+ * ARM64_WORKAROUND_QCOM_ORYON_DC_ZVA clears SCTLR_EL1.DZE, so an EL0 DC ZVA
+ * traps here (and EL0 reads DCZID_EL0.DZP as 1, which keeps glibc, bionic, Go
+ * and the JVM off the instruction by themselves). Emulate it: zero the
+ * DCZID_EL0.BS block that contains the address with ordinary stores, faulting
+ * where a store would (SIGSEGV through arm64_notify_segfault(), as DC CVAU etc.).
+ * The counter at /sys/kernel/debug/qcom_oryon_dc_zva_emulated says how often
+ * user space still runs into the trap.
+ */
+static atomic_t qcom_oryon_dc_zva_emulated = ATOMIC_INIT(0);
+
+static int emulate_dc_zva(unsigned long address)
+{
+	/* DCZID_EL0.BS (bits 3:0) = log2 of the block size in 4-byte words */
+	unsigned long bs = 4UL << (read_sysreg(dczid_el0) & 0xf);
+	void __user *va = (void __user *)(address & ~(bs - 1));
+
+	atomic_inc(&qcom_oryon_dc_zva_emulated);
+	return clear_user(va, bs) ? -EFAULT : 0;
+}
+
