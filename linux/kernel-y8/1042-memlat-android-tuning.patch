+				KAANAPALI_MON_DEFAULTS,
 				.table_len = 2,
 				.table = (const struct scmi_qcom_map_table[]) {
 					{ .cpu_freq_mhz = 3513, .mem_freq_mhz = 0 },
@@ -953,7 +1022,8 @@ static const struct scmi_qcom_memlat_cfg_data kaanapali_memlat_data = {
 	.memory_cfg = kaanapali_memory_cfg,
 	.common_ev = kaanapali_common_ev,
 	.cpucp_legacy_freq_method = true,
-	.cpucp_sample_ms = 4,
+	.mon_tunables = true,
+	.cpucp_sample_ms = 8,
 	.memory_cnt = ARRAY_SIZE(kaanapali_memory_cfg),
 };
 
@@ -1051,6 +1121,34 @@ static int configure_cpucp_mon(struct device *dev, struct scmi_qcom_memlat_info
 	if (ret < 0)
 		return dev_err_probe(dev, ret, "failed to set be_stall_floor for %s\n", mon->name);
 
+	if (info->cfg_data->mon_tunables) {
+		const struct {
+			const char *what;
+			u32 param_id;
+			u32 val;
+		} extra[] = {
+			{ "fe_stall_floor", MEMLAT_FE_STALL_FLOOR, mon->fe_stall_floor },
+			{ "wb_pct", MEMLAT_WB_PCT, mon->wb_pct_thres },
+			{ "ipm_filter", MEMLAT_IPM_FILTER, mon->wb_filter_ipm },
+			{ "freq_scale_pct", MEMLAT_FREQ_SCALE_PCT, mon->freq_scale_pct },
+			{ "freq_scale_ceil", MEMLAT_FREQ_SCALE_CEIL_MHZ, mon->freq_scale_ceil_mhz },
+			{ "freq_scale_floor", MEMLAT_FREQ_SCALE_FLOOR_MHZ, mon->freq_scale_floor_mhz },
+		};
+
+		/*
+		 * Optional: on failure the firmware keeps its default for that
+		 * parameter, which still leaves a working monitor, so do not
+		 * fail the probe (and lose bus scaling) over it.
+		 */
+		for (i = 0; i < ARRAY_SIZE(extra); i++) {
+			scalar.val = cpu_to_le32(extra[i].val);
+			ret = memlat_set_param(info, &scalar, sizeof(scalar), extra[i].param_id);
+			if (ret < 0)
+				dev_warn(dev, "failed to set %s for %s/%s: %d\n",
+					 extra[i].what, cfg->name, mon->name, ret);
+		}
+	}
+
 	map.hw_type = cpu_to_le32(cfg->memory_type);
 	map.mon_idx = cpu_to_le32(monitor_index);
 	map.nr_rows = cpu_to_le32(mon->table_len);
@@ -1170,6 +1268,10 @@ static int scmi_qcom_memlat_configure_events(struct scmi_device *sdev,
 	if (ret < 0)
 		return dev_err_probe(&sdev->dev, ret, "failed to start memory group timer\n");
 
+	dev_info(&sdev->dev, "memlat started, sample %u ms%s\n",
+		 info->cfg_data->cpucp_sample_ms,
+		 info->cfg_data->mon_tunables ? ", per-monitor tunables sent" : "");
+
 	for (i = 0; i < info->memory_cnt; i++) {
 		struct scmi_qcom_memory_info *memory = info->memory[i];
 		const struct scmi_qcom_memory_range *range = &memory->cfg->memory_range;
