 				.name = "mon_0",
 				.cpu_mask = 0x3f,
-				.ipm_ceil = 20000000,
-				.be_stall_floor = 1,
+				.ipm_ceil = 400,
+				KAANAPALI_MON_DEFAULTS,
 				.table_len = 5,
 				.table = (const struct scmi_qcom_map_table[]) {
 					{ .cpu_freq_mhz = 787, .mem_freq_mhz = 282 },
@@ -851,10 +912,11 @@ static const struct scmi_qcom_memory_cfg kaanapali_memory_cfg[] = {
 				}
 			},
 			{
+				/* Android "prime" */
 				.name = "mon_1",
 				.cpu_mask = 0xc0,
-				.ipm_ceil = 20000000,
-				.be_stall_floor = 1,
+				.ipm_ceil = 400,
+				KAANAPALI_MON_DEFAULTS,
 				.table_len = 8,
 				.table = (const struct scmi_qcom_map_table[]) {
 					{ .cpu_freq_mhz = 614, .mem_freq_mhz = 282 },
@@ -868,8 +930,10 @@ static const struct scmi_qcom_memory_cfg kaanapali_memory_cfg[] = {
 				}
 			},
 			{
+				/* Android "gold-compute" */
 				.name = "mon_2",
 				.cpu_mask = 0xff,
+				KAANAPALI_MON_DEFAULTS,
 				.table_len = 2,
 				.table = (const struct scmi_qcom_map_table[]) {
 					{ .cpu_freq_mhz = 2035, .mem_freq_mhz = 282 },
@@ -888,10 +952,11 @@ static const struct scmi_qcom_memory_cfg kaanapali_memory_cfg[] = {
 		.memory_range = { .min_freq_khz = 0, .max_freq_khz = 1 },
 		.monitor_cfg = (const struct scmi_qcom_monitor_cfg[]) {
 			{
+				/* Android "gold" (all eight CPUs) */
 				.name = "mon_0",
 				.cpu_mask = 0xff,
-				.ipm_ceil = 20000000,
-				.be_stall_floor = 1,
+				.ipm_ceil = 700,
+				KAANAPALI_MON_DEFAULTS,
 				.table_len = 2,
 				.table = (const struct scmi_qcom_map_table[]) {
 					{ .cpu_freq_mhz = 2035, .mem_freq_mhz = 0 },
@@ -899,10 +964,11 @@ static const struct scmi_qcom_memory_cfg kaanapali_memory_cfg[] = {
 				}
 			},
 			{
+				/* Android "prime" */
 				.name = "mon_1",
