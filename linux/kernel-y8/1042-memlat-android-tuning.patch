 				.table_len = 2,
 				.table = (const struct scmi_qcom_map_table[]) {
 					{ .cpu_freq_mhz = 1574, .mem_freq_mhz = 0 },
@@ -910,10 +976,11 @@ static const struct scmi_qcom_memory_cfg kaanapali_memory_cfg[] = {
 				}
 			},
 			{
+				/* Android "prime-latfloor" */
 				.name = "mon_2",
 				.cpu_mask = 0xc0,
-				.ipm_ceil = 20000000,
-				.be_stall_floor = 1,
+				.ipm_ceil = 300000,
+				KAANAPALI_MON_DEFAULTS,
 				.table_len = 2,
 				.table = (const struct scmi_qcom_map_table[]) {
 					{ .cpu_freq_mhz = 2131, .mem_freq_mhz = 0 },
@@ -921,8 +988,10 @@ static const struct scmi_qcom_memory_cfg kaanapali_memory_cfg[] = {
 				}
 			},
 			{
