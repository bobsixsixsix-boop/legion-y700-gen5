y700-y9.patch -- cumulative `git diff` of the -t49-y9 kernel tree, written by
kbuild-y9.sh; NOT a single patch. Base: tb323fu-linux t47 source (v7.3-rc4 +
tb323fu 0001-0130). License: GPL-2.0-only (Linux kernel).
It is the sum of these changes (see kernel-y14/patches for the same changes as
individual commits with their authors):
  - iris decode-order / display-delay / deblock controls: originally from
    code002-2/sm8750-video-accel 0001-decode-order-deblock (same code as the
    radxa-pkg/libva-v4l2 kernel patches), rebased by this project (00y1);
  - qcom_battmgr and ath12k changes of this project (00y2-00y5);
  - 0540 arm64 SSBS policy on sigreturn: originally from armada-os/armada,
    extended here to SM8850's part 0x002;
  - 0620, 0621 drm/msm/a6xx GMU fixes by gennro (Kettle), via armada-os/armada;
  - 0622 drm/msm/a6xx HFI mask: originally from armada-os/armada;
  - 1030, 1031 iris fixes by Diogo Trindade, via armada-os/armada;
  - 1032, 1033 (iris), 1041 (ath12k station power save) and 1042 (memlat
    tunables) of this project.

diff --git a/arch/arm64/kernel/signal.c b/arch/arm64/kernel/signal.c
index 38e6fa204..ce4a9aead 100644
--- a/arch/arm64/kernel/signal.c
+++ b/arch/arm64/kernel/signal.c
@@ -22,6 +22,7 @@
 #include <linux/syscalls.h>
 #include <linux/pkeys.h>
 
+#include <asm/cputype.h>
 #include <asm/daifflags.h>
 #include <asm/debug-monitors.h>
 #include <asm/elf.h>
@@ -34,6 +35,7 @@
 #include <asm/ptrace.h>
 #include <asm/syscall.h>
 #include <asm/signal32.h>
+#include <asm/spectre.h>
 #include <asm/traps.h>
 #include <asm/vdso.h>
 
@@ -1010,6 +1012,35 @@ static int parse_user_sigframe(struct user_ctxs *user,
 	return -EINVAL;
 }
 
+/* Wine returns through signal frames that lack PSTATE.SSBS. */
+static int ssbd_sigreturn __ro_after_init = -1;
+
+static int __init parse_ssbd_sigreturn(char *str)
+{
+	bool val;
+
+	if (kstrtobool(str, &val))
+		return -EINVAL;
+	ssbd_sigreturn = val;
+	return 0;
+}
+early_param("ssbd_sigreturn", parse_ssbd_sigreturn);
+
+static int __init ssbd_sigreturn_init(void)
+{
+	static const struct midr_range oryon[] = {
+		MIDR_ALL_VERSIONS(MIDR_QCOM_ORYON_X1),
+		/* y700: SM8850 (TB323FU) Oryon reports implementer 0x51 part 0x002 */
+		MIDR_ALL_VERSIONS(MIDR_CPU_MODEL(ARM_CPU_IMP_QCOM, 0x002)),
+		{}
+	};
+
+	if (ssbd_sigreturn < 0)
+		ssbd_sigreturn = is_midr_in_range_list(oryon);
+	return 0;
+}
+arch_initcall(ssbd_sigreturn_init);
+
 static int restore_sigframe(struct pt_regs *regs,
 			    struct rt_sigframe __user *sf,
 			    struct user_access_state *ua_state)
@@ -1037,6 +1068,8 @@ static int restore_sigframe(struct pt_regs *regs,
 	fpsimd_save_and_flush_current_state();
 
 	err |= !valid_user_regs(&regs->user_regs, current);
+	if (err == 0 && ssbd_sigreturn > 0)
+		spectre_v4_enable_task_mitigation(current);
 	if (err == 0)
 		err = parse_user_sigframe(&user, sf);
 
