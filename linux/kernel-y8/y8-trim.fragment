CONFIG_NET_SCH_HTB=m
CONFIG_NET_SCH_PRIO=m
CONFIG_NET_SCH_MULTIQ=m

# ---- K. Android-only / VM-only / dead-LSM / kexec / 32-bit / unused kernel features
# [medium] binder: only Waydroid/anbox need it; neither is installed (packages, apps), README calls the port
#          "not feasible". kbuild-y7.sh forced CONFIG_ANDROID_BINDERFS=y "t49 features must survive" -> drop that check.
# CONFIG_ANDROID_BINDER_IPC is not set
# CONFIG_ANDROID_BINDERFS is not set
# [low] Android wakelock/autosleep sysfs API: no user in tb323fu-linux, our tools or systemd (grep)
# CONFIG_PM_AUTOSLEEP is not set
# CONFIG_PM_WAKELOCKS is not set
# [low] brd ramdisk: the initramfs is a cpio, not an initrd image
# CONFIG_BLK_DEV_RAM is not set
# [low] SELinux/AppArmor are compiled in but can never run: CONFIG_LSM="landlock,lockdown,yama,loadpin,safesetid,ipe,bpf",
#       CMDLINE_FORCE forbids lsm=, the apparmor userspace package is not installed (README y5: "实际 LSM 是 capability,landlock,yama,bpf")
# CONFIG_SECURITY_SELINUX is not set
# CONFIG_SECURITY_APPARMOR is not set
# [low] integrity subsystem without IMA/EVM only creates two empty keyrings
# CONFIG_INTEGRITY is not set
# [medium] audit: disabled at runtime (dmesg "audit: initializing netlink subsys (disabled)", journald "Collecting
#          audit messages is disabled"), no auditd; sudo/sshd/systemd tolerate a kernel without CONFIG_AUDIT
#          (EPROTONOSUPPORT path). Removes the per-syscall audit hooks and ~100 KB.
# CONFIG_AUDIT is not set
# [low] kexec/crash dump: only used for the kexec-from-Android bring-up (baldur-kexec.fragment); kernel install/
#       rollback goes through the boot slots (tb323fu-ctl), no kexec-tools/kdump packages, no crashkernel= on the cmdline
# CONFIG_KEXEC is not set
# CONFIG_KEXEC_FILE is not set
# CONFIG_CRASH_DUMP is not set
# [low] AArch32 userspace: the Oryon cores have no 32-bit EL0 (dmesg "CPU features" list has no "32-bit EL0 Support"),
#       FEX/Proton/Steam are AArch64 processes; frees the compat syscall table, vdso32, kuser helpers
# CONFIG_COMPAT is not set
# [low] zswap: compiled in, default off (README y5), zram is the swap device; KSM: ksmd never enabled
#       (/sys/kernel/mm/ksm/run = 0, README), no qemu use
# CONFIG_ZSWAP is not set
# CONFIG_KSM is not set

# ---- L. Debug-only hardware tracing [low]: CoreSight funnel/STM/TMC are bound and loaded today (~275 KB of modules,
#      lsmod coresight*, stm_core, stm_p_basic) but nothing reads them; our driver debugging uses kprobes/ftrace/debugfs
# CONFIG_CORESIGHT is not set
# CONFIG_STM is not set

# ---- M. Filesystems [low]: demote built-ins that are never mounted (mounts: ext4 root, squashfs, tmpfs, fuse.portal;
#      /proc/filesystems lists f2fs and nfs but nothing uses them; nfs-common is not installed). Kept as =m so a
#      future `mount -t f2fs/nfs` still works; cifs/btrfs/erofs/iso9660/udf were already =m and stay.
CONFIG_F2FS_FS=m
CONFIG_NFS_FS=m
# NFS=m frees these from vmlinux too (they have prompts, so they would stay =y by inertia)
CONFIG_RPCSEC_GSS_KRB5=m
CONFIG_CRYPTO_KRB5=m
CONFIG_CRYPTO_KRB5ENC=m
CONFIG_CRYPTO_CAMELLIA=m
# CONFIG_DNS_RESOLVER stays =y: NFS_USE_KERNEL_DNS (no prompt, y while NFS_V4=m) selects it back; harmless
