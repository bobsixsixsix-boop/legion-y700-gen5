#!/usr/bin/env python3
"""y700-autobright: automatic screen brightness from the ambient light sensor (2026-10-15).

Plasma 6.6's PowerDevil has no ambient-light mode; the sensor is there (iio-sensor-proxy on the system
bus: net.hadess.SensorProxy, HasAmbientLight, LightLevel in lux, live once claimed). Brightness goes
through KDE's own API (org.kde.ScreenBrightness /org/kde/ScreenBrightness/display0, 0..MaxBrightness,
linear to the aw99706 backlight), so the control centre's slider and PowerDevil stay in sync - unlike
wluma/clight, which write the sysfs backlight behind PowerDevil's back.

  - curve: brightness fraction over log10(lux + 1) (CURVE below), times the owner's learned factor;
  - steady: change only when the smoothed lux left a +/-25 % band around the level of the last change,
    brightening after 1.5 s, darkening after 4 s (a hand over the sensor does nothing); each change
    ramps over 0.8 s with the OSD suppressed; changes under 1.5 % are skipped;
  - learning: a brightness change that is not ours (the owner moved the slider) sets the factor to
    owner/curve at the current light, kept in ~/.config/y700/autobright.json. The first start takes the
    current brightness as the owner's choice, so switching it on never jumps;
  - screen off (DPMS): nothing changes and the light sensor is released; on wake it is claimed again
    and the first reading is applied at once.
Run by y700-autobright.service (user); on/off/status: y700-autobright-ctl.
"""
import json, math, os, sys, time
import gi
gi.require_version("Gio", "2.0")
from gi.repository import Gio, GLib

CONF = os.path.expanduser("~/.config/y700/autobright.json")
# (lux, fraction of max brightness) - interpolated over log10(lux + 1)
CURVE = [(0, 0.06), (3, 0.10), (10, 0.16), (40, 0.26), (100, 0.36), (300, 0.50),
         (800, 0.65), (2000, 0.82), (5000, 1.0)]
BAND = 0.25                      # relative lux change that triggers an adjustment
BRIGHTEN_S, DARKEN_S = 1.5, 4.0  # how long the light must stay outside the band
TAU_S = 1.5                      # lux smoothing time constant
MIN_FRAC, MIN_STEP = 0.02, 0.015
RAMP_STEPS, RAMP_MS = 8, 100
SUPPRESS_OSD = 0x1
# only connected connectors: the disconnected DP-1 and the Writeback connector report dpms "On" forever,
# which made the first version believe the screen was always on (found 2026-10-15; DSI-1 stays
# "connected" while its dpms goes Off)
DPMS = [os.path.join("/sys/class/drm", d, "dpms") for d in os.listdir("/sys/class/drm")
        if os.path.exists(os.path.join("/sys/class/drm", d, "dpms"))
        and (open(os.path.join("/sys/class/drm", d, "status")).read().strip() == "connected"
             if os.path.exists(os.path.join("/sys/class/drm", d, "status")) else False)]


def log(*a):
    print(*a, flush=True)


def curve(lux):
    x = math.log10(max(lux, 0) + 1)
    pts = [(math.log10(l + 1), f) for l, f in CURVE]
    if x <= pts[0][0]:
        return pts[0][1]
    for (x0, f0), (x1, f1) in zip(pts, pts[1:]):
        if x <= x1:
            return f0 + (f1 - f0) * (x - x0) / (x1 - x0)
    return pts[-1][1]


def screen_on():
    for p in DPMS:
        try:
            if open(p).read().startswith("On"):
                return True
        except OSError:
            pass
    return not DPMS


class AutoBright:
    def __init__(self):
        self.sys = Gio.bus_get_sync(Gio.BusType.SYSTEM)
        self.ses = Gio.bus_get_sync(Gio.BusType.SESSION)
        self.sensor = Gio.DBusProxy.new_sync(self.sys, 0, None, "net.hadess.SensorProxy",
                                             "/net/hadess/SensorProxy", "net.hadess.SensorProxy", None)
        self.disp = Gio.DBusProxy.new_sync(self.ses, 0, None, "org.kde.ScreenBrightness",
                                           "/org/kde/ScreenBrightness/display0", "org.kde.ScreenBrightness.Display", None)
        self.max = self.prop(self.disp, "MaxBrightness") or 10000
        self.cfg = self.load()
        self.ema = None
        self.ref = None              # smoothed lux at the last change
        self.out_since = None        # when the lux left the band (monotonic s)
        self.ours = set()            # brightness values we set and have not seen echoed back yet
        self.ramp = None
        self.was_on = screen_on()
        self.last_t = time.monotonic()
        self.sensor.call_sync("ClaimLight", None, 0, -1, None)
        self.sensor.connect("g-properties-changed", self.on_sensor)
        self.disp.connect("g-properties-changed", self.on_display)
        GLib.timeout_add(1000, self.on_tick)          # band timers and DPMS, also without new readings
        lux = self.prop(self.sensor, "LightLevel") or 0.0
        if "factor" not in self.cfg:                  # first run: today's brightness is the owner's choice
            cur = (self.prop(self.disp, "Brightness") or self.max / 2) / self.max
            self.cfg["factor"] = self.clamp_factor(cur / max(curve(lux), 1e-3)) if lux > 0 else 1.0
            self.save()
        log(f"start: lux {lux:.0f}, brightness {self.prop(self.disp, 'Brightness')}/{self.max}, factor {self.cfg['factor']:.2f}")
        if not self.was_on:                           # started with the screen off: no readings until it is on
            self.sensor.call_sync("ReleaseLight", None, 0, -1, None)

    @staticmethod
    def prop(proxy, name):
        v = proxy.get_cached_property(name)
        return v.unpack() if v is not None else None

    @staticmethod
    def clamp_factor(f):
        return max(0.25, min(4.0, f))

    def load(self):
        try:
            return json.load(open(CONF))
        except Exception:
            return {}

    def save(self):
        os.makedirs(os.path.dirname(CONF), exist_ok=True)
        tmp = CONF + ".tmp"
        json.dump(self.cfg, open(tmp, "w"))
        os.replace(tmp, CONF)

    def target(self, lux):
        return max(MIN_FRAC, min(1.0, curve(lux) * self.cfg["factor"]))

    def on_sensor(self, proxy, changed, invalidated):
        lux = changed.unpack().get("LightLevel")
        if lux is None:
            return
        now = time.monotonic()
        dt, self.last_t = now - self.last_t, now
        a = 1 - math.exp(-dt / TAU_S) if self.ema is not None else 1
        self.ema = lux if self.ema is None else self.ema + a * (lux - self.ema)
        self.evaluate()

    def on_tick(self):
        on = screen_on()
        if on != self.was_on:
            # screen off: let go of the light sensor, so iio-sensor-proxy, the system bus and this process
            # stop waking several times a second for readings nobody uses (power audit 2026-10-15);
            # screen on: claim it again - the first reading after that starts a fresh average and is
            # applied at once (ref None)
            try:
                self.sensor.call_sync("ClaimLight" if on else "ReleaseLight", None, 0, -1, None)
            except GLib.Error as e:
                log(f"{'claim' if on else 'release'} light: {e.message}")
            self.ema, self.ref, self.out_since = None, None, None
            log("screen on: light sensor claimed" if on else "screen off: light sensor released")
        self.was_on = on
        self.evaluate()
        return True

    def evaluate(self):
        if self.ema is None or not self.was_on or self.ramp:
            return
        now = time.monotonic()
        if self.ref is None:
            self.apply(self.ema, "start/wake")
            return
        hi, lo = self.ref * (1 + BAND) + 2, self.ref * (1 - BAND) - 2     # +-2 lux: no flapping in the dark
        if lo <= self.ema <= hi:
            self.out_since = None
            return
        self.out_since = self.out_since or now
        if now - self.out_since >= (BRIGHTEN_S if self.ema > hi else DARKEN_S):
            self.apply(self.ema, "light changed")

    def apply(self, lux, why):
        self.ref, self.out_since = lux, None
        cur = (self.prop(self.disp, "Brightness") or 0) / self.max
        tgt = self.target(lux)
        if abs(tgt - cur) < MIN_STEP:
            return
        log(f"{why}: lux {lux:.0f} -> brightness {cur:.2f} -> {tgt:.2f}")
        steps = [cur + (tgt - cur) * (i + 1) / RAMP_STEPS for i in range(RAMP_STEPS)]
        self.ramp = steps

        def step():
            if not self.ramp:
                return False
            v = int(round(self.ramp.pop(0) * self.max))
            self.ours.add(v)
            self.disp.call("SetBrightness", GLib.Variant("(iu)", (v, SUPPRESS_OSD)), 0, -1, None, None, None)
            if not self.ramp:
                self.ramp = None
                GLib.timeout_add(1500, self.forget_ours)
                return False
            return True
        GLib.timeout_add(RAMP_MS, step)

    def forget_ours(self):
        self.ours.clear()
        return False

    def on_display(self, proxy, changed, invalidated):
        b = changed.unpack().get("Brightness")
        if b is None:
            return
        # ours: KDE may echo a value rounded through the 4095-step backlight, so match within a few units
        mine = [v for v in self.ours if abs(v - b) <= 8]
        if mine or self.ramp:
            for v in mine:
                self.ours.discard(v)
            return
        # not ours: the owner moved the slider (PowerDevil's idle dimming is off on this tablet)
        if self.ema is None or self.ema <= 0:
            return
        f = self.clamp_factor((b / self.max) / max(curve(self.ema), 1e-3))
        if abs(f - self.cfg["factor"]) > 0.02:
            self.cfg["factor"] = f
            self.save()
            log(f"owner set {b}/{self.max} at lux {self.ema:.0f}: factor {f:.2f}")
        self.ref = self.ema          # and stay there until the light really changes


def main():
    try:
        AutoBright()
    except GLib.Error as e:
        log(f"cannot start: {e.message}")
        sys.exit(1)
    GLib.MainLoop().run()


if __name__ == "__main__":
    main()
