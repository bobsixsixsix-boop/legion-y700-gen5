[Unit]
Description=y700: automatic screen brightness from the ambient light sensor
PartOf=graphical-session.target
After=graphical-session.target

[Service]
# Rust since 2026-11-03 (linux/display/autobright/install.sh); the Python version it replaced: git ea2b225
ExecStart=/usr/local/libexec/y700-autobright
Restart=on-failure
RestartSec=5

[Install]
WantedBy=graphical-session.target
