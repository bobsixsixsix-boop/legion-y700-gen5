[Unit]
Description=y700: panel refresh rate follows the video (30/60 Hz for fullscreen 30/60 fps video, base 120 Hz otherwise)
PartOf=graphical-session.target
After=graphical-session.target plasma-kwin_wayland.service

[Service]
# Rust since 2026-11-03 (linux/display/refresh-auto/daemon/install.sh); the Python version it replaced: git 669f79f
ExecStart=/usr/local/libexec/y700-refresh-auto
# after any exit (clean, crash, SIGKILL): if the panel was left at 30/60 Hz, put the base back (a full modeset at 30/60 Hz,
# e.g. the next screen-on, makes the panel flicker)
ExecStopPost=-/usr/local/libexec/y700-refresh-auto --restore
Restart=on-failure
RestartSec=5
# on stop the daemon puts the base mode back itself (SIGTERM handler); give kscreen-doctor the time
TimeoutStopSec=10
# SIGTERM to the daemon only: it ends its own kscreen-doctor child and restores the base itself
KillMode=mixed

[Install]
WantedBy=graphical-session.target
