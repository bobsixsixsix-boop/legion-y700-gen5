{
  "manifest_version": 3,
  "name": "Y700 video state",
  "version": "1.5",
  "description": "Tells y700-refresh-auto when a video plays full screen and at what frame rate, so the panel's refresh rate can follow it; hides AV1 from pages (no hardware decoder for it on this tablet) and hides the page behind a fullscreen video (the GPU keeps drawing it).",
  "key": "",
  "permissions": ["nativeMessaging"],
  "background": {"service_worker": "sw.js"},
  "content_scripts": [{
    "matches": ["<all_urls>"],
    "js": ["content.js"],
    "all_frames": true,
    "match_about_blank": true,
    "run_at": "document_idle"
  }, {
    "matches": ["<all_urls>"],
    "js": ["no-av1.js"],
    "all_frames": true,
    "match_about_blank": true,
    "run_at": "document_start",
    "world": "MAIN"
  }]
}
