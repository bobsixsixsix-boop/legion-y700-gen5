#!/usr/bin/env python3
"""y700-refresh-auto: the panel's refresh rate follows the video (goal, 2026-10-16: switch automatically between
30, 60 and 120 Hz by the video source, 120 Hz by default for games and touch). Version 2, after three independent reviews (README "刷新率跟随视频").

Base mode (default 120 Hz; the control centre's refresh tile or any other foreign switch to 60/90/120/164 sets it) is
used for touch, games and everything else; the kernel's idle refresh still drops the panel to 60/30 Hz on a static
picture. The KWin mode goes to the video's rate while ALL of these hold:
  - the active window covers the screen (KWin script y700-refresh-auto reports class, "covers" = fullscreen or >= 80 %
    of the output, and pid on every activation / fullscreen / geometry change);
  - a player state file ($XDG_RUNTIME_DIR/y700-video/*, written by the wiliwili patch and the mpv script) with that
    pid says playing=1 fullscreen=1 osd=0, and the process is alive;
  - no touch / pen / volume-key input for touch_hold_s (3 s), screen on, session not locked, no sleep in progress;
  - for enter_delay_s (1.5 s).
Video rate = config "map" applied to the EFFECTIVE fps (source fps x playback speed), only rates that divide the panel
rate evenly: 29-31 -> 30 Hz, 14.5-15.5 -> 30, 9.5-10.5 -> 30, 58-61 -> 60, 19.5-20.5 -> 60; everything else (24/25/48/
50 fps, 45 fps at 1.5x ...) and unknown -> base (120 is 5 x 24: no 3:2 judder); while danmaku are on at least danmaku_min_hz (60: danmaku move every refresh, 30 Hz steps are visible). Only 120 / 60 / 30
are lowered to: they are one timing family (patch 0066) switched in place (0065); 90 and 164 differ, so 90/164 <-> 30/60
would be a full modeset - with a 90 or 164 Hz base nothing is lowered.
Flicker guard (0065: a FULL modeset at 60/30 Hz makes the CSOT panel flicker, e.g. the screen turning back on): a power
key press, the lock screen and PrepareForSleep (a logind delay inhibitor gives us the time) go back to the base at once;
while the panel is below the base the screen state is checked once a second and a screen-off goes back to the base; the
video rate is never set with the screen off. On exit (SIGTERM, crash, SIGKILL) ExecStopPost runs --restore.
Event-driven otherwise: file monitors, D-Bus, evdev, pidfds; touch devices are only read while a video wants a lower
rate; kscreen-doctor runs only on a change (5 s timeout; after a failed switch the next one waits 1, 2, 4 ... 30 s,
going back to the base included; 3 failures in a row: no lowering for 60 s).
Config: ~/.config/y700-refresh-auto.json. Logs: journalctl --user -u y700-refresh-auto. Status: gdbus call --session
-d fyi.y700.RefreshAuto -o /RefreshAuto -m fyi.y700.RefreshAuto.status
"""
import functools, glob, json, os, signal, struct, sys, time, traceback
import gi
gi.require_version("Gio", "2.0")
from gi.repository import Gio, GLib
try:                                    # GLib >= 2.80 moved the unix helpers; avoid the deprecation warning
    gi.require_version("GLibUnix", "2.0")
    from gi.repository import GLibUnix
    fd_add, signal_add = GLibUnix.fd_add_full, GLibUnix.signal_add
except (ValueError, ImportError, AttributeError):
    fd_add, signal_add = GLib.unix_fd_add_full, GLib.unix_signal_add

NAME = "fyi.y700.RefreshAuto"
CONF = os.path.expanduser("~/.config/y700-refresh-auto.json")
KWINCONF = os.path.expanduser("~/.config/kwinoutputconfig.json")
STATEDIR = os.path.join(os.environ.get("XDG_RUNTIME_DIR", "/run/user/%d" % os.getuid()), "y700-video")
KWIN_SCRIPT = os.path.expanduser("~/.local/share/kwin/scripts/y700-refresh-auto/contents/code/main.js")
INPLACE = (120, 60, 30)                 # one timing family (0066), switched in place (0065)
BASE_CHOICES = (60, 90, 120, 164)       # a foreign switch to one of these is the owner's new base; 30 never is
DEFAULTS = {
    "enabled": True,
    "base_hz": 120,
    "enter_delay_s": 1.5,
    "touch_hold_s": 3.0,
    "unknown_fps_hz": 0,                # 0 = base: an unknown rate may be 24/25 fps (judder at 30/60 Hz)
    "danmaku_min_hz": 60,
    # [min_fps, max_fps, hz] on the effective fps (fps x speed); first match wins; hz 0 = base; no match -> base.
    # Only rates that divide the panel rate evenly (judder-free) are lowered; 24/25/48/50 fps stay at the base: 120 is
    # 5 x 24, while 24 fps at 60 Hz is 3:2 judder and 25/50 fps judder 17 ms at 60 Hz vs 8 ms at 120 ("follow the source").
    "map": [[29.0, 31.0, 30], [58.0, 61.0, 60], [14.5, 15.5, 30], [19.5, 20.5, 60], [9.5, 10.5, 30]],
}
DPMS = glob.glob("/sys/class/drm/card*-DSI-1/dpms")
EV_FMT = "llHHi"; EV_SIZE = struct.calcsize(EV_FMT); EV_KEY = 1; KEY_POWER = 116
TOUCHISH = ("NVTCapacitiveTouchScreen", "NVTCapacitivePen", "pmic_resin", "gpio-keys")   # touch, pen, volume keys


def log(msg):
    print(msg, flush=True)


def safe(keep):
    """GLib callbacks: an exception would silently remove the source (PyGObject clears the return value)"""
    def deco(fn):
        @functools.wraps(fn)
        def w(*a):
            try:
                return fn(*a)
            except Exception:
                log(traceback.format_exc())
                return keep
        return w
    return deco


def screen_on():
    for p in DPMS:
        try:
            return open(p).read().startswith("On")
        except OSError:
            pass
    return True


def input_devices():
    out, name = {}, None
    try:
        for line in open("/proc/bus/input/devices"):
            if line.startswith("N: Name="):
                name = line.split("=", 1)[1].strip().strip('"')
            elif line.startswith("H: Handlers=") and name:
                for h in line.split("=", 1)[1].split():
                    if h.startswith("event"):
                        out[name] = "/dev/input/" + h
    except OSError:
        pass
    return out


def load_cfg():
    cfg = json.loads(json.dumps(DEFAULTS))
    try:
        j = json.load(open(CONF))
    except Exception:
        return cfg
    if not isinstance(j, dict):
        return cfg
    for k, v in j.items():
        if k not in DEFAULTS:
            continue
        d = DEFAULTS[k]
        if isinstance(d, bool):
            ok = isinstance(v, bool)
        elif isinstance(d, (int, float)):
            ok = isinstance(v, (int, float)) and not isinstance(v, bool) and v >= 0
        else:
            ok = isinstance(v, list) and all(isinstance(r, list) and len(r) == 3 and
                                             all(isinstance(x, (int, float)) and not isinstance(x, bool) for x in r) for r in v)
        if ok:
            cfg[k] = v
        else:
            log(f"config: ignoring {k}={v!r} (wrong type)")
    return cfg


def save_cfg(cfg):
    os.makedirs(os.path.dirname(CONF), exist_ok=True)
    tmp = CONF + ".tmp"
    with open(tmp, "w") as f:
        json.dump(cfg, f, indent=1)
    os.replace(tmp, CONF)


def kwin_hz():
    try:
        for blk in json.load(open(KWINCONF)):
            if blk.get("name") == "outputs":
                for o in blk.get("data", []):
                    if str(o.get("connectorName", "")).startswith("DSI"):
                        return int(round(o["mode"]["refreshRate"] / 1000))
    except Exception:
        pass
    return None


def current_hz():
    """KWin's mode from kwinoutputconfig.json, else kscreen-doctor's current mode"""
    hz = kwin_hz()
    if hz is not None:
        return hz
    try:
        ok, out, err, status = GLib.spawn_sync(None, ["kscreen-doctor", "-j"], None, GLib.SpawnFlags.SEARCH_PATH, None)
        for o in json.loads(out.decode()).get("outputs", []):
            if o.get("name", "").startswith("DSI"):
                for m in o.get("modes", []):
                    if str(m.get("id")) == str(o.get("currentModeId")):
                        return int(round(m.get("refreshRate", 0)))
    except Exception:
        pass
    return None


def pick_hz(fps, cfg, base):
    if not fps or fps <= 0:
        return int(cfg["unknown_fps_hz"]) or base
    for lo, hi, hz in cfg["map"]:
        if lo <= fps <= hi:
            return int(hz) or base
    return base


def mode_name(hz):
    return f"1904x3040@{hz}"


IFACE = """<node><interface name="fyi.y700.RefreshAuto">
  <method name="activeWindow"><arg type="s" name="resourceClass" direction="in"/><arg type="b" name="covers" direction="in"/>
    <arg type="i" name="pid" direction="in"/></method>
  <method name="status"><arg type="s" name="json" direction="out"/></method>
</interface></node>"""


class RefreshAuto:
    output = "DSI-1"

    def __init__(self):
        self.ses = Gio.bus_get_sync(Gio.BusType.SESSION)
        self.sys = Gio.bus_get_sync(Gio.BusType.SYSTEM)
        r = self.ses.call_sync("org.freedesktop.DBus", "/org/freedesktop/DBus", "org.freedesktop.DBus", "RequestName",
                               GLib.Variant("(su)", (NAME, 4)), GLib.VariantType("(u)"), 0, -1, None)   # 4 = DO_NOT_QUEUE
        if r.unpack()[0] not in (1, 4):
            log("another y700-refresh-auto owns the name: exiting")
            sys.exit(0)
        self.cfg = load_cfg(); save_cfg(self.cfg)
        self.modes = {}; self.warned = set()
        self.read_modes()
        self.cur_hz = current_hz()
        if not DPMS:
            log("no DSI dpms node: the screen-off guard cannot work, video rates disabled")
        self.expected = None            # (hz, until): a switch of ours not yet seen in kwinoutputconfig.json
        self.requested = {}             # hz -> when we asked for it, until it is seen landed (a late KWin write is still ours)
        self.players = {}               # state file name -> state dict
        self.pidfds = {}                # pid -> (fd, source)
        self.active = ("", False, 0)    # (resourceClass, covers, pid)
        self.last_touch = 0.0
        self.locked = False
        self.manual = False             # the owner chose a mode while a video wanted another: no override until things change
        self.backoff_until = 0.0; self.fails = 0
        self.retry_at = 0.0; self.retry_src = None   # after a failed switch: no kscreen-doctor before retry_at (fail())
        self.enter_src = self.hold_src = self.dpms_src = self.kwin_src = self.kill_src = None
        self.mode_proc = None; self.pending = False
        self.touch_fds = {}             # fd -> source, open only while a video wants a lower rate
        self.shield_until = 0.0; self.shielded = 0   # touches right after our own switch (see on_touch)
        self.sleep_fd = None
        node = Gio.DBusNodeInfo.new_for_xml(IFACE)
        # PyGObject 3.56 / GLib 2.88: register_object is deprecated in favour of register_object_with_closures2 (same callback)
        reg = getattr(self.ses, "register_object_with_closures2", None) or self.ses.register_object
        reg("/RefreshAuto", node.interfaces[0], self.on_call, None, None)
        self.ses.signal_subscribe(None, "org.freedesktop.ScreenSaver", "ActiveChanged", None, None, 0, self.on_lock)
        try:
            self.locked = bool(self.ses.call_sync("org.freedesktop.ScreenSaver", "/ScreenSaver", "org.freedesktop.ScreenSaver",
                                                  "GetActive", None, GLib.VariantType("(b)"), 0, 1000, None).unpack()[0])
        except Exception:
            pass
        self.sys.signal_subscribe("org.freedesktop.login1", "org.freedesktop.login1.Manager", "PrepareForSleep",
                                  "/org/freedesktop/login1", None, 0, self.on_sleep)
        self.take_sleep_lock()
        os.makedirs(STATEDIR, mode=0o700, exist_ok=True)
        self.dirmon = Gio.File.new_for_path(STATEDIR).monitor_directory(Gio.FileMonitorFlags.WATCH_MOVES, None)
        self.dirmon.connect("changed", self.on_statedir)
        self.cfgmon = Gio.File.new_for_path(KWINCONF).monitor_file(Gio.FileMonitorFlags.WATCH_MOVES, None)
        self.cfgmon.connect("changed", self.on_kwinconf)
        for f in os.listdir(STATEDIR):
            if not f.endswith(".tmp"):
                self.read_player(f)
        devs = input_devices()
        self.touch_paths = [devs[n] for n in TOUCHISH if n in devs]
        if "pmic_pwrkey" in devs:
            try:
                fd = os.open(devs["pmic_pwrkey"], os.O_RDONLY | os.O_NONBLOCK)
                fd_add(GLib.PRIORITY_DEFAULT, fd, GLib.IOCondition.IN, self.on_power, None)
            except OSError as e:
                log(f"cannot open the power key: {e}")
        log(f"start: base {self.cfg['base_hz']} Hz, now {self.cur_hz} Hz, modes {sorted(self.modes)}, locked {self.locked}, "
            f"players {list(self.players)}, touch inputs {len(self.touch_paths)}")
        self.reload_kwin_script()
        self.evaluate("start")

    # ---------------------------------------------------------------- modes / switching
    def read_modes(self):
        try:
            ok, out, err, status = GLib.spawn_sync(None, ["kscreen-doctor", "-j"], None, GLib.SpawnFlags.SEARCH_PATH, None)
            for o in json.loads(out.decode()).get("outputs", []):
                if o.get("name", "").startswith("DSI"):
                    self.output = o["name"]
                    for m in o.get("modes", []):
                        hz = int(round(m.get("refreshRate", 0)))
                        if m.get("size", {}).get("height") in (3040, 1904):
                            self.modes[hz] = mode_name(hz)
        except Exception as e:
            log(f"kscreen-doctor -j failed: {e}")
        if not self.modes:
            GLib.timeout_add_seconds(2, self.retry_modes)

    @safe(False)
    def retry_modes(self):
        self.read_modes()
        if self.modes:
            log(f"modes {sorted(self.modes)}")
            self.evaluate("modes read")
        return False

    def expecting(self):
        if self.expected and time.monotonic() > self.expected[1]:
            self.expected = None
        return self.expected[0] if self.expected else None

    def set_hz(self, hz, why):
        if hz not in self.modes:
            if hz not in self.warned:
                log(f"no {hz} Hz mode known ({sorted(self.modes)}): not switching ({why})"); self.warned.add(hz)
            return
        if self.mode_proc is not None:          # one kscreen-doctor at a time; on_mode_done looks again at once
            self.pending = True
            return
        if hz == self.cur_hz and self.expecting() in (None, hz):
            return
        if self.fails and time.monotonic() < self.retry_at:
            if self.retry_src is None:
                self.retry_src = GLib.timeout_add(int((self.retry_at - time.monotonic()) * 1000) + 1, self.on_retry)
            return
        log(f"{self.cur_hz} -> {hz} Hz ({why})")
        try:
            self.mode_proc = Gio.Subprocess.new(["kscreen-doctor", f"output.{self.output}.mode.{self.modes[hz]}"],
                                                Gio.SubprocessFlags.STDOUT_SILENCE | Gio.SubprocessFlags.STDERR_SILENCE)
        except Exception as e:
            log(f"kscreen-doctor did not start: {e}")
            self.fail()
            return
        now = time.monotonic()
        self.expected = (hz, now + 5); self.requested[hz] = now
        self.kill_src = GLib.timeout_add_seconds(5, self.on_mode_timeout, self.mode_proc)
        self.mode_proc.wait_async(None, self.on_mode_done, hz)
        if hz != self.cfg["base_hz"]:
            self.watch_dpms()

    @safe(False)
    def on_mode_timeout(self, proc):
        log("kscreen-doctor still running after 5 s: killed")
        self.kill_src = None
        proc.force_exit()                       # wait_async completes, on_mode_done cleans up
        return False

    @safe(False)
    def on_retry(self):
        self.retry_src = None
        self.evaluate("retry after a failed switch")
        return False

    def fail(self):
        # The next try waits 1, 2, 4 ... 30 s. backoff_until only stops LOWERING: going back to the base was retried by
        # on_mode_done's 300 ms re-look and the 1 Hz screen-off tick with no delay at all - a kscreen-doctor every
        # ~0.35 s for as long as switching failed (10-19 audit, simulated: 170+ in 60 s screen off).
        self.fails += 1
        self.retry_at = time.monotonic() + min(30, 2 ** (self.fails - 1))
        if self.fails >= 3:
            self.backoff_until = time.monotonic() + 60
            log("3 failed switches in a row: no lowering for 60 s")

    @safe(None)
    def on_mode_done(self, proc, res, hz):
        if self.kill_src:
            GLib.source_remove(self.kill_src); self.kill_src = None
        try:
            proc.wait_finish(res); ok = proc.get_successful()
        except Exception:
            ok = False
        self.mode_proc = None
        now = current_hz()
        if now is not None:
            self.cur_hz = now
        if now == hz or not ok:
            self.expected = None
        if now == hz:
            self.requested.pop(hz, None)        # landed: a later switch to this rate is not ours
        if ok and now == hz:
            self.fails = 0
            if hz != self.cfg["base_hz"]:
                self.shield_until = time.monotonic() + 1.5
        elif not ok:
            log(f"kscreen-doctor did not switch to {hz} Hz")
            self.fail()
        want, _ = self.want()
        if self.pending or want != hz:
            self.pending = False
            GLib.idle_add(self.evaluate_once, "after switch")
        else:
            GLib.timeout_add(300, self.evaluate_once, "after switch")

    def watch_dpms(self):
        if self.dpms_src is None:
            self.dpms_src = GLib.timeout_add_seconds(1, self.on_dpms_tick)

    @safe(True)
    def on_dpms_tick(self):
        base = self.cfg["base_hz"]
        if self.cur_hz == base and self.expecting() in (None, base):
            self.dpms_src = None
            return False
        if not screen_on():
            self.drop_to_base("screen off")     # KWin keeps the mode for the off pipeline: the next wake is at the base
        return True

    # ---------------------------------------------------------------- KWin's mode file
    @safe(None)
    def on_kwinconf(self, mon, f, other, ev):
        if self.kwin_src is None:               # coalesce the burst of events of one QSaveFile write
            self.kwin_src = GLib.timeout_add(100, self.check_kwin)

    @safe(False)
    def check_kwin(self):
        self.kwin_src = None
        hz = kwin_hz()
        if hz is None or hz == self.cur_hz:
            return False
        exp = self.expecting()
        self.cur_hz = hz
        # ours: the switch we are waiting for, or an earlier request of ours that had not landed yet (e.g. 30 landing
        # after a touch already asked for the base). A request that HAS landed was removed from self.requested, so the
        # owner later picking that same rate (control centre tile) is not mistaken for ours (10-16 test 2: 164 -> 120).
        late = time.monotonic() - self.requested.get(hz, -1e9) < 10
        self.requested.pop(hz, None)
        if exp == hz:
            self.expected = None
            return False
        if late:
            self.evaluate("late write of our switch")
            return False
        vt = self.video_target()
        if hz not in BASE_CHOICES or hz == vt:
            # 30, or the rate the video wants anyway (the display watchdog's "back to the current mode"): not a choice
            log(f"mode changed to {hz} Hz by someone else: not taken as the base")
            self.evaluate("foreign mode")
            return False
        log(f"mode changed to {hz} Hz by someone else: new base {hz} Hz")
        self.cfg["base_hz"] = hz; save_cfg(self.cfg)
        if vt is not None:
            self.manual = True
        self.evaluate("new base")
        return False

    # ---------------------------------------------------------------- players
    @safe(None)
    def on_statedir(self, mon, f, other, ev):
        if ev == Gio.FileMonitorEvent.RENAMED:  # inside the directory: other = the new name
            names = [other.get_basename()] if other else []
        else:                                   # MOVED_IN / CREATED / CHANGES_DONE / DELETED ...: file is the one here
            names = [f.get_basename()]
        changed = False
        for n in names:
            if not n or n.endswith(".tmp"):
                continue
            if ev in (Gio.FileMonitorEvent.DELETED, Gio.FileMonitorEvent.MOVED_OUT):
                changed |= self.players.pop(n, None) is not None
            elif ev in (Gio.FileMonitorEvent.RENAMED, Gio.FileMonitorEvent.MOVED_IN, Gio.FileMonitorEvent.CREATED,
                        Gio.FileMonitorEvent.CHANGES_DONE_HINT):
                changed |= self.read_player(n)
        if changed:
            self.evaluate("player state")

    def summary(self, st):
        return None if st is None else (st["playing"], st["fullscreen"], st["osd"], st["danmaku"],
                                        pick_hz(st["fps"], self.cfg, self.cfg["base_hz"]))

    def read_player(self, name):
        """returns True when something that matters for the decision changed"""
        path = os.path.join(STATEDIR, name)
        old = self.players.get(name)
        try:
            kv = dict(line.strip().partition("=")[::2] for line in open(path) if "=" in line)
            st = {"pid": int(kv.get("pid", 0)), "playing": kv.get("playing") == "1", "fullscreen": kv.get("fullscreen") == "1",
                  "osd": kv.get("osd") == "1", "danmaku": kv.get("danmaku") == "1", "fps": float(kv.get("fps", 0) or 0)}
        except (OSError, ValueError):
            return self.players.pop(name, None) is not None
        if not st["pid"] or not os.path.exists(f"/proc/{st['pid']}"):
            self.unlink_if(path, st["pid"])
            return self.players.pop(name, None) is not None
        self.players[name] = st
        if st["pid"] not in self.pidfds:
            try:
                fd = os.pidfd_open(st["pid"])
                self.pidfds[st["pid"]] = (fd, fd_add(GLib.PRIORITY_DEFAULT, fd, GLib.IOCondition.IN, self.on_player_exit, st["pid"]))
            except OSError:
                pass
        if old is None or old["pid"] != st["pid"] or (old["playing"], old["fullscreen"]) != (st["playing"], st["fullscreen"]):
            self.manual = False
        return self.summary(old) != self.summary(st) or (old or {}).get("pid") != st["pid"]

    @staticmethod
    def unlink_if(path, pid):
        try:
            if f"pid={pid}" in open(path).read().split():
                os.unlink(path)
        except OSError:
            pass

    @safe(False)
    def on_player_exit(self, fd, cond, pid):
        fdsrc = self.pidfds.pop(pid, None)
        if fdsrc:
            os.close(fdsrc[0])
        for n, st in list(self.players.items()):
            if st["pid"] == pid:
                del self.players[n]
                self.unlink_if(os.path.join(STATEDIR, n), pid)
        log(f"player {pid} exited")
        self.evaluate("player exited")
        return False

    # ---------------------------------------------------------------- inputs
    @safe(True)
    def on_power(self, fd, cond, data):
        press = False
        try:
            while True:
                buf = os.read(fd, EV_SIZE * 32)
                if not buf:
                    break
                for i in range(0, len(buf) - EV_SIZE + 1, EV_SIZE):
                    _, _, typ, code, val = struct.unpack(EV_FMT, buf[i:i + EV_SIZE])
                    press |= typ == EV_KEY and code == KEY_POWER and val == 1
        except BlockingIOError:
            pass
        if press:
            self.last_touch = time.monotonic()
            self.drop_to_base("power key")      # the screen is about to go off (or on): base first
            self.schedule_hold()
        return True

    @safe(True)
    def on_touch(self, fd, cond, data):
        try:
            while os.read(fd, EV_SIZE * 64):    # only "something happened" matters: drain, no parsing
                pass
        except BlockingIOError:
            pass
        except OSError:                         # device gone (driver re-probe): drop it, reopened on the next attach
            self.touch_fds.pop(fd, None)
            os.close(fd)
            return False
        if time.monotonic() < self.shield_until:
            # the control centre saw the touch screen send phantom touches right after a mode switch (its own 90/164
            # switches, full modesets). The in-place 120/60/30 switches showed none in the 10-16 tests; if they ever
            # do, ignoring them here keeps a switch from undoing itself. Counted in the status ("shielded_touches").
            self.shielded += 1
            return True
        self.last_touch = time.monotonic()
        if self.cur_hz != self.cfg["base_hz"] or self.expecting() not in (None, self.cfg["base_hz"]) or self.enter_src:
            self.drop_to_base("touch")
        self.schedule_hold()
        return True

    def attach_touch(self, on):
        if on and not self.touch_fds:
            for p in self.touch_paths:
                try:
                    fd = os.open(p, os.O_RDONLY | os.O_NONBLOCK)
                    self.touch_fds[fd] = fd_add(GLib.PRIORITY_DEFAULT, fd, GLib.IOCondition.IN, self.on_touch, None)
                except OSError as e:
                    log(f"cannot open {p}: {e}")
        elif not on and self.touch_fds:
            for fd, src in self.touch_fds.items():
                GLib.source_remove(src); os.close(fd)
            self.touch_fds = {}

    def schedule_hold(self):
        if self.hold_src is None:
            self.hold_src = GLib.timeout_add(int(self.cfg["touch_hold_s"] * 1000) + 50, self.on_hold_end)

    @safe(False)
    def on_hold_end(self):
        self.hold_src = None
        left = self.cfg["touch_hold_s"] - (time.monotonic() - self.last_touch)
        if left > 0.05:
            self.hold_src = GLib.timeout_add(int(left * 1000) + 50, self.on_hold_end)
            return False
        self.evaluate("touch hold over")
        return False

    # ---------------------------------------------------------------- session
    @safe(None)
    def on_lock(self, conn, sender, path, iface, sig, params):
        self.locked = bool(params.unpack()[0])
        if self.locked:
            self.drop_to_base("lock screen")
        else:
            self.evaluate("unlocked")

    def take_sleep_lock(self):
        if self.sleep_fd is not None:
            return
        try:
            ret, fdl = self.sys.call_with_unix_fd_list_sync(
                "org.freedesktop.login1", "/org/freedesktop/login1", "org.freedesktop.login1.Manager", "Inhibit",
                GLib.Variant("(ssss)", ("sleep", "y700-refresh-auto", "panel back to its base refresh rate", "delay")),
                GLib.VariantType("(h)"), Gio.DBusCallFlags.NONE, -1, None, None)
            self.sleep_fd = fdl.steal_fds()[ret.unpack()[0]]
        except Exception as e:
            log(f"no sleep delay inhibitor: {e}")

    def release_sleep_lock(self):
        if self.sleep_fd is not None:
            os.close(self.sleep_fd); self.sleep_fd = None
        return False

    @safe(None)
    def on_sleep(self, conn, sender, path, iface, sig, params):
        if params.unpack()[0]:
            self.drop_to_base("sleep")
            GLib.timeout_add(1500, self.release_sleep_lock)   # let the switch land, then let logind go on
        else:
            self.take_sleep_lock()
            self.evaluate("resumed")

    @safe(None)
    def on_call(self, conn, sender, path, iface, method, params, inv):
        if method == "activeWindow":
            cls, covers, pid = params.unpack()
            if pid != self.active[2]:
                self.manual = False
            self.active = (cls, bool(covers), int(pid))
            inv.return_value(None)
            self.evaluate(f"active window {cls or '-'} (pid {pid}, covers {bool(covers)})")
        elif method == "status":
            inv.return_value(GLib.Variant("(s)", (json.dumps({
                "base_hz": self.cfg["base_hz"], "cur_hz": self.cur_hz, "expected_hz": self.expecting(),
                "video_target": self.video_target(), "active": self.active, "players": self.players, "manual": self.manual,
                "locked": self.locked, "touch_age_s": round(time.monotonic() - self.last_touch, 1),
                "touch_attached": bool(self.touch_fds), "shielded_touches": self.shielded,
                "backoff": self.backoff_until > time.monotonic()}),)))

    def reload_kwin_script(self):
        """Run the KWin script now, so that it reports the current active window. The script must stay ENABLED (metadata
        EnabledByDefault: true): Scripting.start() unloads a disabled script at once. If this fails, KWin's own load at
        login still reports. Do not switch to /Scripting/Script<id>.run: ids are reused after an unload."""
        if not os.path.exists(KWIN_SCRIPT):
            log(f"KWin script missing: {KWIN_SCRIPT}")
            return
        try:
            px = Gio.DBusProxy.new_sync(self.ses, 0, None, "org.kde.KWin", "/Scripting", "org.kde.kwin.Scripting", None)
            px.call_sync("unloadScript", GLib.Variant("(s)", ("y700-refresh-auto",)), 0, 2000, None)
            sid = px.call_sync("loadScript", GLib.Variant("(ss)", (KWIN_SCRIPT, "y700-refresh-auto")), 0, 2000, None).unpack()[0]
            if sid < 0:
                log("KWin refused to load the script (already loaded?)")
            px.call_sync("start", None, 0, 2000, None)
            if not px.call_sync("isScriptLoaded", GLib.Variant("(s)", ("y700-refresh-auto",)), 0, 2000, None).unpack()[0]:
                log("the KWin script is not loaded after start(): disabled in System Settings? (no window reports)")
        except Exception as e:
            log(f"could not (re)load the KWin script: {e}")

    # ---------------------------------------------------------------- decision
    def video_target(self):
        cls, covers, pid = self.active
        if not covers or not pid:
            return None
        st = next((s for s in self.players.values() if s["pid"] == pid), None)
        if not st or not (st["playing"] and st["fullscreen"] and not st["osd"]):
            return None
        hz = pick_hz(st["fps"], self.cfg, self.cfg["base_hz"])
        if st["danmaku"] and hz < self.cfg["danmaku_min_hz"]:
            hz = self.cfg["danmaku_min_hz"]
        return hz

    def want(self):
        """(hz, recheck): recheck = touched recently, look again when the hold is over"""
        base = self.cfg["base_hz"]
        if not self.cfg.get("enabled", True) or self.locked or self.manual or time.monotonic() < self.backoff_until or not DPMS:
            return base, False
        v = self.video_target()
        if v is None or v >= base or base not in INPLACE or v not in INPLACE:
            return base, False
        if time.monotonic() - self.last_touch < self.cfg["touch_hold_s"]:
            return base, True
        return v, False

    def drop_to_base(self, why):
        if self.enter_src:
            GLib.source_remove(self.enter_src); self.enter_src = None
        base = self.cfg["base_hz"]
        if self.cur_hz != base or self.expecting() not in (None, base):
            self.set_hz(base, why)

    def evaluate(self, why):
        self.attach_touch(self.video_target() is not None)
        hz, recheck = self.want()
        if recheck:
            self.schedule_hold()
        if hz == self.cfg["base_hz"]:
            self.drop_to_base(why)
            return
        if self.enter_src is None and (self.cur_hz != hz or self.expecting() not in (None, hz)):
            self.enter_src = GLib.timeout_add(int(self.cfg["enter_delay_s"] * 1000), self.on_enter, why)

    @safe(False)
    def on_enter(self, why):
        self.enter_src = None
        hz, recheck = self.want()
        if recheck:
            self.schedule_hold()
        if hz != self.cfg["base_hz"] and screen_on():
            self.set_hz(hz, f"{why}: fullscreen video for pid {self.active[2]}")
        return False

    @safe(False)
    def evaluate_once(self, why):
        self.evaluate(why)
        return False

    def stop(self):
        try:
            if self.mode_proc is not None:      # an in-flight switch must not land after ours
                try:
                    self.mode_proc.force_exit(); self.mode_proc.wait(None)
                except Exception:
                    pass
            restore(self.cfg["base_hz"], "exit")
        finally:
            loop.quit()
        return False


def restore(base=None, why="restore"):
    """put the base back if the panel is left below it (ExecStopPost: also after a crash or SIGKILL)"""
    if base is None:
        base = load_cfg()["base_hz"]
    now = kwin_hz()
    if now is not None and now != base and now in (30, 60) and base in BASE_CHOICES:
        log(f"{why}: {now} -> {base} Hz")
        try:
            GLib.spawn_sync(None, ["timeout", "8", "kscreen-doctor", f"output.DSI-1.mode.{mode_name(base)}"], None,
                            GLib.SpawnFlags.SEARCH_PATH, None)
        except Exception as e:
            log(f"{why}: kscreen-doctor failed: {e}")


