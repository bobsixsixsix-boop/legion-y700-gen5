+/* y700 (TB323FU): WCN7860 with the Android GNG firmware completes ML association with an
+ * MLO AP but its EAPOL 2/4 over the MLO link is never acked (4WAY_HANDSHAKE_TIMEOUT), so
+ * 5/6 GHz MLO SSIDs never connect. Unless wcn7860_mlo=1, do not advertise MLO for this chip:
+ * the station then associates single-link (non-ML) and the handshake goes through.
+ */
+static bool ath12k_wcn7860_mlo;
+module_param_named(wcn7860_mlo, ath12k_wcn7860_mlo, bool, 0444);
+MODULE_PARM_DESC(wcn7860_mlo, "Advertise MLO on WCN7860 (default: off)");
