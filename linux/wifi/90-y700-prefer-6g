#!/bin/sh
# y700: if the tablet lands on HOME_2.4G (HOME_6G not seen in the first scan), move to
# HOME_6G once it shows up. HOME_5G is left manual: it loses beacons ~10 s after connecting.
# A failure - `con up HOME_6G` failed, or back on HOME_2.4G within 5 min of a switch that worked, on the same
# interface (HOME_6G dropped at once: seen at the edge of its range) - used to be retried on every return to
# HOME_2.4G: a drop every minute or two for as long as it lasted (2026-10-31 audit). Now it stays on HOME_2.4G
# until a HOME_2.4G connection (reconnect, CarPlay's hotspot gone, reboot) more than 30 min after the failure.
# A switch that worked blocks nothing after those 5 min, nor once the interface was recreated (ath12k reloaded
# by the Wi-Fi watchdog or for CarPlay's hotspot): nothing runs this again, so the first fix (no switch for
# 30 min after any switch) left the tablet on HOME_2.4G for the evening after such a drop (2026-10-31 review).
FAIL=/run/y700-prefer-6g.fail      # mtime = when a switch to HOME_6G last failed or did not hold
HELD=/run/y700-prefer-6g.held      # the ifindex of the last switch to HOME_6G that worked, mtime = when
NET=/sys/class/net
[ "$2" = up ] && [ "$CONNECTION_ID" = "HOME_2.4G" ] || exit 0
[ -n "$(find "$HELD" -mmin -5 2>/dev/null)" ] && [ "$(cat "$HELD")" = "$(cat "$NET/$1/ifindex" 2>/dev/null)" ] && touch "$FAIL"
if [ -n "$(find "$FAIL" -mmin -30 2>/dev/null)" ]; then
	logger -t y700-prefer-6g "the last switch to HOME_6G failed or did not hold, less than 30 min ago: staying on HOME_2.4G"
	exit 0
fi
(
	for i in 1 2 3 4 5 6; do
		sleep 20
		[ "$(nmcli -g GENERAL.CONNECTION dev show "$1")" = "HOME_2.4G" ] || exit 0
		nmcli dev wifi rescan ifname "$1" 2>/dev/null; sleep 5
		if nmcli -g SSID dev wifi list ifname "$1" | grep -qx HOME_6G; then
			logger -t y700-prefer-6g "HOME_6G visible, switching from HOME_2.4G"
			if nmcli con up HOME_6G ifname "$1"; then cat "$NET/$1/ifindex" > "$HELD"
			else touch "$FAIL"; nmcli con up HOME_2.4G ifname "$1"; fi
			exit 0
		fi
	done
) >/dev/null 2>&1 &
